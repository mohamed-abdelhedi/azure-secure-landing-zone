# Terraform Local Cache & State
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
*.tfplan.binary

# Terraform variable definitions (containing potential credentials/secrets)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Crash and execution logs
crash.log
crash.*.log
*.log

# Python cache (diagram generators)
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Security scanning outputs
*.sarif
checkov_report.json
trivy-results.sarif

# Certificates and keys
*.pem
*.key
*.crt
*.pfx

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db
